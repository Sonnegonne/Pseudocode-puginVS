{
  "name": "PseudoCodeDC",
  "displayName": "PseudoCodeDC",
  "description": "Coloration syntaxique et exécution de pseudo-code en français, interprété en JavaScript",
  "version": "0.7.2",
  "publisher": "Pseudocode",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:pseudocode",
    "onCommand:pseudocode.run",
    "onCommand:pseudocode.stop"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pseudocode",
        "aliases": [
          "PseudoCode",
          "pseudo"
        ],
        "extensions": [
          ".pseudo"
        ],
        "configuration": "./syntaxes/language-configuration.json",
        "defaultEncoding": "utf8"
      }
    ],
    "grammars": [
      {
        "language": "pseudocode",
        "scopeName": "source.pseudocode",
        "path": "./syntaxes/pseudocode.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "pseudocode.run",
        "title": "Exécuter le pseudo-code",
        "icon": "$(play)"
      },
      {
        "command": "pseudocode.stop",
        "title": "Arrêter l'exécution",
        "icon": "$(debug-stop)"
      },
      {
        "command": "pseudocode.diagnosticIA",
        "title": "Vérifier les assistants IA",
        "category": "PseudoCode"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == pseudocode",
          "command": "pseudocode.stop",
          "group": "navigation@2"
        },
        {
          "when": "resourceLangId == pseudocode",
          "command": "pseudocode.run",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pseudocode.run",
        "key": "f5",
        "when": "editorLangId == pseudocode"
      },
      {
        "command": "pseudocode.stop",
        "key": "shift+f5",
        "when": "editorLangId == pseudocode"
      }
    ],
    "configurationDefaults": {
      "[pseudocode]": {
        "editor.inlineSuggest.enabled": false,
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        },
        "editor.suggestOnTriggerCharacters": true,
        "editor.suggest.showWords": false,
        "editor.suggest.showSnippets": false,
        "editor.suggest.showKeywords": true,
        "editor.suggest.showVariables": true,
        "editor.wordBasedSuggestions": "off"
      },
      "chat.disableAIFeatures": true,
      "github.copilot.enable": {
        "pseudocode": false
      },
      "github.copilot.nextEditSuggestions.enabled": false
    },
    "configuration": {
      "title": "PseudoCode",
      "properties": {
        "pseudocode.targetFramework": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Framework .NET cible du projet temporaire. `auto` retient la plus haute version majeure disposant a la fois d'un SDK et d'un runtime sur la machine. Indiquez sinon une valeur explicite, par exemple `net8.0`.",
          "pattern": "^(auto|net[0-9]+\\.[0-9]+)$",
          "patternErrorMessage": "Utilisez auto ou un moniker de la forme netX.Y (ex. net10.0)."
        },
        "pseudocode.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "markdownDescription": "Chemin de l'executable `dotnet`. A renseigner uniquement si le SDK .NET n'est pas dans le PATH."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "eslint": "^8.56.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
